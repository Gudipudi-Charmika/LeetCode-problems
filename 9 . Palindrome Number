class Solution(object):
    def isPalindrome(self, x):
        """
        :type x: int
        :rtype: bool
        """
        n=x
        rev=0
        if x<0:
            return False
        else:
            while x!=0:
                r=x%10
                rev=rev*10+r
                x=x//10
            if n==rev:
                return True
            else:
                return False
            
         
