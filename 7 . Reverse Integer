class Solution(object):
    def reverse(self, x):
        """
        :type x: int
        :rtype: int
        """
        rev=0
        n=x
        def dtob(n):
            res=""
            while(n!=0):
                rem=n%2
                if rem==1:
                    res+="1"
                else:
                    res+="0"
                n=n//2
            return res[::-1]
        if x<0:
            x=-x
        while x!=0:
            r=x%10
            rev=rev*10+r
            x=x//10
        m=dtob(rev)
        if len(m)>=32:
            return 0
        elif(n<0):
            return (-1*rev)
        return rev   
