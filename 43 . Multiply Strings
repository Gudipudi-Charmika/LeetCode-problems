class Solution:
    def multiply(self, num1: str, num2: str) -> str:
        num=0
        num3=0
        n=len(num1)
        if num1==0 or num2==0:
            return "0"
        else:
            for i in num1:
                num=num*10+(ord(i)-48)
            c=num
            p=len(num2)
            for i in num2:
                num3=num3*10+(ord(i)-48)
            q=num3
            m=c*q
            return str(m)
